# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ----------------
# Dependencies
# ----------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----------------
# Testing / Coverage
# ----------------
/coverage

# ----------------
# Next.js
# ----------------
/.next/
/out/

# ----------------
# Build artifacts
# ----------------
/build
dist

# ----------------
# Logs / Debug
# ----------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.log

# ----------------
# Env & secrets
# ----------------
# Never commit any env or secret keys
.env
.env.*
*.pem
serviceAccountKey.json
firebase-private-key.pem

# ----------------
# Vercel
# ----------------
.vercel

# ----------------
# TypeScript
# ----------------
*.tsbuildinfo
next-env.d.ts

# ----------------
# Editors / OS junk
# ----------------
.DS_Store
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# ----------------
# Firebase local artifacts
# ----------------
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# ----------------
# Misc caches
# ----------------
.eslintcache
.turbo/
